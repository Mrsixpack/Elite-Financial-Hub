{
  "name": "elite-finance-hub",
  "version": "1.0.0",
  "description": "Elite Financial Hub - Professional Personal Finance Platform for MrSixPack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=elite-finance-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name elite-finance-hub",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:create": "wrangler d1 create elite-finance-production",
    "db:migrate:local": "wrangler d1 migrations apply elite-finance-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply elite-finance-production",
    "db:seed": "wrangler d1 execute elite-finance-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute elite-finance-production --local",
    "db:console:prod": "wrangler d1 execute elite-finance-production",
    "kv:create": "wrangler kv:namespace create elite_sessions",
    "kv:create:preview": "wrangler kv:namespace create elite_sessions --preview",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "logs": "wrangler pages deployment tail",
    "git:commit": "git add . && git commit -m",
    "git:status": "git status",
    "git:push": "git push origin main"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.5",
    "hono": "^4.0.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250705.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "typescript": "^5.0.0",
    "vite": "^5.4.19",
    "wrangler": "^3.78.0",
    "xlsx": "^0.18.5"
  }
}
